# Local container user IDs. Match your host user if needed (`id -u`, `id -g`).
LOCAL_UID=1000
LOCAL_GID=1000

# Local-only PostgreSQL credentials. Change before exposing any service beyond localhost.
POSTGRES_DB=stock_master
POSTGRES_USER=stock_master
POSTGRES_PASSWORD=stock_master_dev
POSTGRES_PORT=5432

# NVIDIA hosted models (build.nvidia.com, free tier). Create an nvapi-... key there.
# Do not commit a populated .env file.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional backup provider: Gemini via its OpenAI-compatible endpoint (competition Google Cloud credits).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=

# Ordered provider:model failover chain tried before the deterministic fallback.
# Leave empty to use NVIDIA_MODEL then GEMINI_MODEL.
# Example: LLM_CHAIN=nvidia:nvidia/nemotron-3-ultra-550b-a55b,nvidia:z-ai/glm-5.3,gemini:<gemini-model-id>
LLM_CHAIN=

# Optional: FinMind token (fallback data source) and an alert webhook (e.g. Slack incoming webhook).
FINMIND_API_TOKEN=
ALERT_WEBHOOK_URL=
